# Copy to .env.local for local work. Never commit real values.
# Set BOTH in Vercel (Production and Preview) too. If either is missing or too short, the site fails closed.

# Shared preview password, 14+ characters
YPS_SITE_PASSWORD=replace-with-a-long-unique-password

# Signing secret, 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating either value signs everyone out.
YPS_SESSION_SECRET=replace-with-at-least-32-random-characters
